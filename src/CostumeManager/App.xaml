<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CostumeManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CostumeManager"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentInk"        Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentInkStrong"  Color="#1E40AF" />
            <SolidColorBrush x:Key="AccentSoftFill"   Color="#EEF4FF" />
            <SolidColorBrush x:Key="AccentSoftStroke" Color="#C7D9FE" />

            <SolidColorBrush x:Key="WarnInk"    Color="#92400E" />
            <SolidColorBrush x:Key="WarnFill"   Color="#FEF3C7" />
            <SolidColorBrush x:Key="WarnStroke" Color="#FCD34D" />

            <SolidColorBrush x:Key="OkInk" Color="#15803D" />

            <SolidColorBrush x:Key="LogDoneInk"  Color="#DC2626" />
            <SolidColorBrush x:Key="LogErrorInk" Color="#B91C1C" />

            <Style x:Key="SectionHeader" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <Style x:Key="ValueChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Background" Value="{StaticResource AccentSoftFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftStroke}" />
            </Style>

            <Style x:Key="WarnBanner" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Background" Value="{StaticResource WarnFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource WarnStroke}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
