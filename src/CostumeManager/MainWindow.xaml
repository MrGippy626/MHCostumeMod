<Window
    x:Class="CostumeManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:CostumeManager"
    Title="Marvel Heroes Costume Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <muxc:NavigationView x:Name="Nav"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>

                <muxc:NavigationViewItem Content="Home"     Tag="home"     IsSelected="True" />
                <muxc:NavigationViewItem Content="Install"  Tag="install" />
                <muxc:NavigationViewItem Content="Textures" Tag="textures" />
                <muxc:NavigationViewItem Content="Icons"    Tag="icons" />
                <muxc:NavigationViewItem Content="Effects"  Tag="effects" />
                <muxc:NavigationViewItem Content="Manage"   Tag="manage" />
                <muxc:NavigationViewItem Content="Repair"   Tag="repair" />
                <muxc:NavigationViewItem Content="Settings" Tag="settings" />
            </muxc:NavigationView.MenuItems>

            <Grid RowDefinitions="*,Auto,Auto,Auto">
                <Frame x:Name="ContentFrame" Grid.Row="0" />

                <local:LogSizer Grid.Row="1" x:Name="LogGrip" Height="12"
                                Background="Transparent"
                                PointerPressed="Grip_PointerPressed"
                                PointerMoved="Grip_PointerMoved"
                                PointerReleased="Grip_PointerReleased"
                                PointerCaptureLost="Grip_PointerReleased"
                                PointerEntered="Grip_PointerEntered"
                                PointerExited="Grip_PointerExited"
                                ToolTipService.ToolTip="Drag to resize the log">
                    <Rectangle x:Name="GripPill" Width="140" Height="5" RadiusX="2.5" RadiusY="2.5"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                </local:LogSizer>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Padding="12,6"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <ToggleButton Grid.Column="0" x:Name="BtnLog" Content="Log"
                                  Checked="LogToggle" Unchecked="LogToggle" />
                    <TextBlock Grid.Column="1" x:Name="TxtLogCount" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy all" Click="CopyLog_Click" />
                        <Button Content="Clear" Click="ClearLog_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="3" x:Name="LogScroll" Height="160"
                              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                              Padding="12,8">

                    <RichTextBlock x:Name="LogText" IsTextSelectionEnabled="True"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
