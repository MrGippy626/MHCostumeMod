<Page
    x:Class="CostumeManager.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="1000" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Install a costume" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Pick a mod's UPK. The donor is detected from the package itself; everything else is derived." />
            </StackPanel>

            <Border Padding="16" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="1 · COSTUME UPK" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" x:Name="TxtUpk" IsReadOnly="True"
                                 PlaceholderText="Pick the mod's UC__MarvelPlayer_*.upk" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseUpk_Click" />
                        <Button Grid.Column="2" x:Name="BtnClearUpk" Content="Clear"
                                IsEnabled="False" Click="ClearUpk_Click" />
                    </Grid>

                    <ProgressBar x:Name="BarDetect" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtDetected" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Text="Donor — pick a UPK to detect" />
                    <TextBlock x:Name="TxtDonorIds" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Donor costume" Margin="0,6,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="CmbDonor" IsEditable="True" HorizontalAlignment="Stretch"
                              SelectionChanged="Donor_Changed" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="2 · IDENTITY" Style="{StaticResource SectionHeader}" />

                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Custom name — internal (A-Z 0-9)" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="TxtCustomName" TextChanged="Inputs_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Display name — shown in game" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="TxtDisplay" TextChanged="Inputs_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Store price (G)" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="TxtStorePrice" MinWidth="92" Text="750"
                                     TextAlignment="Right" FontFamily="Consolas"
                                     TextChanged="Inputs_Changed"
                                     ToolTipService.ToolTip="What this costume's token costs in the in-game store. Leave blank to use the server's own default." />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Enum (assigned)" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border MinWidth="92" Style="{StaticResource ValueChip}">
                                <TextBlock x:Name="TxtEnum" Text="—" FontFamily="Consolas"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AccentInkStrong}"
                                           IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="3">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Custom name — used internally, never shown to players. It is what the mod's files and objects are renamed to, so it must be unique. Changing it later makes a different costume." />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Display name — the name players see in game, on the store card and in the inventory. Spaces and punctuation are fine here." />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Store price — what the token costs in G in the in-game store. Yours to set; leave it blank to let the server use its own default. It is written to ServerCostumes.json, so restart the server for a change to show." />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Enum — assigned for you, and the server has to agree with it, so it is not editable." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="3 · ICONS" Style="{StaticResource SectionHeader}" />

                    <CheckBox x:Name="ChkUseCustomIcons"
                              Content="Install custom icons with this costume"
                              Checked="UseCustomIcons_Changed" Unchecked="UseCustomIcons_Changed" />

                    <TextBlock x:Name="TxtIconSummary" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Pick a UPK first." />

                    <ItemsControl x:Name="InstallIconList">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,4,10,0" Padding="8"
                                        Tag="{Binding Role}" Click="PickIconForRole_Click"
                                        ToolTipService.ToolTip="{Binding Tooltip}"
                                        AutomationProperties.Name="{Binding RoleName}"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Width="118">

                                        <Border Width="102" Height="102" CornerRadius="6"
                                                Background="#0A0B0D" HorizontalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Image}" Stretch="Uniform" Margin="8" />
                                                <TextBlock Text="{Binding Placeholder}" FontSize="11"
                                                           TextWrapping="Wrap" TextAlignment="Center"
                                                           Margin="8" VerticalAlignment="Center"
                                                           Visibility="{Binding PlaceholderVisibility}"
                                                           Foreground="#8A8F98" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding RoleName}" FontSize="12"
                                                   FontWeight="SemiBold" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FileName}" FontSize="10.5"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="4 · WHAT WILL HAPPEN" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="TxtPreview" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Pick a UPK and a game folder." />
                    <InfoBar x:Name="BarWarn" IsOpen="False" IsClosable="False" Severity="Warning" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnVerify"  Content="Verify" Click="Verify_Click" IsEnabled="False" />
                        <Button x:Name="BtnInstall" Content="Install costume" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
