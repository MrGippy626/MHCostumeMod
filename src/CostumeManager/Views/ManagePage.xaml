<Page
    x:Class="CostumeManager.Views.ManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Installed costumes" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="TxtSub" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Reads CustomCostumes.json from the selected game folder. Uninstall removes the UPK, the JSON entry, and the TFC manifest rows." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="BtnToggleEdit"  Content="Show / hide…" Click="ToggleEdit_Click" />
                <Button x:Name="BtnApply"       Content="Apply"  Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" />
                <Button x:Name="BtnCancel"      Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />

                <Button x:Name="BtnBulkExport"     Content="Export bundle…" Click="BulkExport_Click" />
                <Button x:Name="BtnExportSelected" Content="Export selected" Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}" Click="ExportSelected_Click" />
                <Button x:Name="BtnExportAll"      Content="Export all" Visibility="Collapsed"
                        Click="ExportAll_Click" />
                <Button x:Name="BtnExportCancel"   Content="Cancel" Visibility="Collapsed"
                        Click="ExportCancel_Click" />

                <Button x:Name="BtnRefresh"     Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" x:Name="TxtSearch" PlaceholderText="Search by hero or name…"
                 TextChanged="Search_Changed" />

        <Grid Grid.Row="2">
            <ScrollViewer>
                <StackPanel Spacing="0">
                    <ItemsControl x:Name="InstalledList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                                        BorderThickness="1" Opacity="{Binding RowOpacity}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  Visibility="{Binding PickerVisibility}"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                  Visibility="{Binding ExportPickVisibility}"
                                                  IsChecked="{Binding Selected, Mode=TwoWay}" />

                                        <Border Grid.Column="1" Width="56" Height="56"
                                                VerticalAlignment="Center" CornerRadius="6"
                                                Background="#0A0B0D">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Spacing="2">

                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{Binding EnumAndDonor}" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Upk}" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding SubText}" TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ActionsVisibility}">
                                            <Button Content="Export"    Tag="{Binding Enum}" Click="Export_Click" />
                                            <Button Content="Uninstall" Tag="{Binding Enum}" Click="Uninstall_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
