<Page
    x:Class="CostumeManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="6" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Folders" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12"
                       Text="Set these once - they are remembered between sessions." />

            <Border Padding="16" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="GAME FOLDER" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" x:Name="TxtGameDir"
                                 PlaceholderText="C:\MarvelHeroes"
                                 TextChanged="GameDir_TextChanged" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseGame_Click" />
                    </Grid>
                    <InfoBar x:Name="BarGame" IsOpen="False" IsClosable="False" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Costume UPKs go to UnrealEngine3\MarvelGame\CookedPCConsole, and CustomCostumes.json to UnrealEngine3\Binaries\Win64." />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="6" BorderThickness="1" Margin="0,12,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="SERVER FOLDER (OPTIONAL)" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" x:Name="TxtServerDir"
                                 PlaceholderText="...\MHServerEmu-master\build"
                                 TextChanged="ServerDir_TextChanged" />
                        <Button Grid.Column="1" Content="Browse" Click="BrowseServer_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Point this at the server's build folder so ServerCostumes.json lands there directly. Uninstall also queues its token purge here, and that file is what reserves a freed enum until the server has run it." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtResolved" Margin="0,16,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
