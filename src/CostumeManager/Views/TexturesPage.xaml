<Page
    x:Class="CostumeManager.Views.TexturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Textures in this mod" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="TxtHeader" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Pick a UPK on the Install page to inspect its DDS textures." />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="DdsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>

                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" Margin="0,0,10,10" Padding="10" CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <Border Height="120" CornerRadius="4"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" />
                                </Border>

                                <TextBlock Text="{Binding Target}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding Kind}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding File}" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
