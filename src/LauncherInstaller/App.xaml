<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LauncherInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LauncherInstaller"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ToggleSwitchFillOff"                Color="#7F1D1D" />
            <Color x:Key="ToggleSwitchFillOffPointerOver">#FF7F1D1D</Color>
            <Color x:Key="ToggleSwitchFillOffPressed">#FF7F1D1D</Color>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff"              Color="#EF4444" />
            <Color x:Key="ToggleSwitchStrokeOffPointerOver">#FFEF4444</Color>
            <Color x:Key="ToggleSwitchStrokeOffPressed">#FFEF4444</Color>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff"            Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed"     Color="#FFFFFF" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn"                 Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"      Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"          Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn"               Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver"    Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"        Color="#1D4ED8" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"             Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver"  Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"      Color="#FFFFFF" />

            <SolidColorBrush x:Key="ToggleSwitchContainerBackground"            Color="Transparent" />
            <Color x:Key="ToggleSwitchContainerBackgroundPointerOver">#00000000</Color>
            <Color x:Key="ToggleSwitchContainerBackgroundPressed">#00000000</Color>

            <SolidColorBrush x:Key="AccentInk"        Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentInkStrong"  Color="#1E40AF" />
            <SolidColorBrush x:Key="AccentSoftFill"   Color="#EEF4FF" />
            <SolidColorBrush x:Key="AccentSoftStroke" Color="#C7D9FE" />

            <SolidColorBrush x:Key="WarnInk"    Color="#92400E" />
            <SolidColorBrush x:Key="WarnFill"   Color="#FEF3C7" />
            <SolidColorBrush x:Key="WarnStroke" Color="#FCD34D" />

            <SolidColorBrush x:Key="OkInk" Color="#15803D" />

            <Style x:Key="SectionHeader" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>

            <Style x:Key="RowTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="RowSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ValueChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Background" Value="{StaticResource AccentSoftFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftStroke}" />
            </Style>

            <SolidColorBrush x:Key="AccentButtonBackground"            Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed"     Color="#1E40AF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled"    Color="#BFD0F5" />
            <SolidColorBrush x:Key="AccentButtonForeground"            Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed"     Color="#EAF1FF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled"    Color="#F3F6FD" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush"           Color="#1D4ED8" />

            <SolidColorBrush x:Key="OverlayScrim" Color="#E60B1220" />

            <Style x:Key="OverlayPanel" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Background" Value="#FCFDFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentSoftStroke}" />
            </Style>

            <Style x:Key="OverlayTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentInkStrong}" />
            </Style>

            <Style x:Key="OverlayRule" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{StaticResource AccentSoftStroke}" />
                <Setter Property="Margin" Value="0,2,0,6" />
            </Style>

            <Style x:Key="OverlayField" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="Background" Value="{StaticResource AccentSoftFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#E2EAFB" />
            </Style>

            <Style x:Key="WarnBanner" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Background" Value="{StaticResource WarnFill}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource WarnStroke}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
