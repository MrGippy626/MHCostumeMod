<Window
    x:Class="LauncherInstaller.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LauncherInstaller"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1220" Offset="0.0" />
                    <GradientStop Color="#1E3A8A" Offset="0.55" />
                    <GradientStop Color="#312E81" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Image x:Name="ImgBackground" Stretch="UniformToFill" Visibility="Collapsed" />

        <Grid Padding="28,22" RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="MARVEL HEROES" FontSize="24" FontWeight="Bold"
                           CharacterSpacing="150" Foreground="White" />
                <TextBlock x:Name="TxtSubtitle" Text="Custom Costumes" FontSize="12.5"
                           CharacterSpacing="110" Foreground="#C7D2FE" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Spacing="11" MaxWidth="540">

                <Button x:Name="BtnPlay" Click="Play_Click"
                        AutomationProperties.Name="Play"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Left"
                        PointerEntered="Play_PointerEntered" PointerExited="Play_PointerExited">

                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled"     Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled"    Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled"     Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled"    Color="Transparent" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>

                    <Border x:Name="PlayFace" CornerRadius="8" Padding="52,15" Background="#1D4ED8">
                        <StackPanel>
                            <TextBlock x:Name="TxtPlay" Text="PLAY" FontSize="27" FontWeight="Bold"
                                       CharacterSpacing="130" Foreground="White"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>

                <ToggleSwitch x:Name="SwUseMod" Margin="0,2,0,0"
                              OnContent="Play with mod" OffContent="Play with mod"
                              Foreground="White" Toggled="UseMod_Toggled" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                    <Grid Width="26" Height="26" VerticalAlignment="Center">

                        <Ellipse x:Name="LampGlow" Width="26" Height="26" Opacity="0.55" />

                        <Ellipse x:Name="LampCore" Width="15" Height="15"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Ellipse Width="5" Height="4" Margin="7,7,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="#B0FFFFFF" />
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtServerName" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock x:Name="TxtStatus" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#D1D5DB" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="ProblemBanner" Visibility="Collapsed" CornerRadius="8"
                        Padding="14,11" Background="#7F1D1D" BorderThickness="1"
                        BorderBrush="#B91C1C">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Not ready to launch" FontWeight="SemiBold"
                                   Foreground="White" FontSize="13" />
                        <TextBlock x:Name="TxtProblems" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="#FECACA" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="4"
                            Orientation="Horizontal">

                    <TextBlock Text="SERVER" FontSize="11" CharacterSpacing="120"
                               Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="CmbServer" MinWidth="180" SelectionChanged="Server_Changed" />
                    <Button x:Name="BtnRecheck" Content="Recheck" Click="Recheck_Click"
                            Padding="12,6" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Bottom">
                    <Button x:Name="BtnVerify" Content="Check content" Click="Verify_Click" Padding="18,8" />
                    <Button x:Name="BtnTools" Content="Tools" Click="Tools_Click" Padding="18,8" />
                    <Button x:Name="BtnSettings" Content="Settings" Click="Settings_Click" Padding="18,8" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="{StaticResource OverlayScrim}">

            <Border MaxWidth="660" Margin="24" VerticalAlignment="Center" Style="{StaticResource OverlayPanel}">

                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="Settings" Style="{StaticResource OverlayTitle}" />
                        <Border Style="{StaticResource OverlayRule}" />
                    </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                <StackPanel Spacing="10">

                    <Border Style="{StaticResource OverlayField}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Game program" Style="{StaticResource RowTitle}" />
                        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                            <TextBox x:Name="TxtGameExe" Grid.Column="0" />
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseExe_Click" />
                        </Grid>
                        <TextBlock Text="MarvelHeroesOmega.exe, inside your Marvel Heroes folder."
                                   Style="{StaticResource RowSub}" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverlayField}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Mod file" Style="{StaticResource RowTitle}" />
                        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                            <TextBox x:Name="TxtDllPath" Grid.Column="0" />
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseDll_Click" />
                        </Grid>
                        <TextBlock Text="The .dll that adds custom costumes. Normally sits beside this launcher."
                                   Style="{StaticResource RowSub}" />
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverlayField}">
                      <StackPanel Spacing="6">

                        <TextBlock Text="Servers" Style="{StaticResource RowTitle}" />
                        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TxtServerSummary" Grid.Column="0"
                                       VerticalAlignment="Center" Style="{StaticResource RowSub}" />
                            <Button Grid.Column="1" Content="Manage servers…" Click="ManageServers_Click" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverlayField}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Extra options" Style="{StaticResource RowTitle}" />
                        <TextBox x:Name="TxtExtraArgs" />
                        <TextBlock Text="Passed to the game as-is. Leave alone unless you were told to change it."
                                   Style="{StaticResource RowSub}" />
                      </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="SettingsCancel_Click" Padding="18,8" />
                        <Button Content="Save" Click="SettingsSave_Click" Padding="18,8"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ServersOverlay" Visibility="Collapsed" Background="{StaticResource OverlayScrim}">
            <Border MaxWidth="640" Margin="24" VerticalAlignment="Center" Style="{StaticResource OverlayPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Servers" Style="{StaticResource OverlayTitle}" />
                    <Border Style="{StaticResource OverlayRule}" />

                    <ListView x:Name="ListServers" MaxHeight="240" SelectionMode="Single"
                              BorderThickness="1" CornerRadius="4"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              SelectionChanged="ServerRow_Changed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ServerRow">

                                <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="{x:Bind Url}" Style="{StaticResource RowSub}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Edit" Tag="{x:Bind}"
                                            VerticalAlignment="Center" Click="ServerEdit_Click" />
                                    <Button Grid.Column="2" Content="Remove" Tag="{x:Bind}"
                                            VerticalAlignment="Center" Click="ServerRemove_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="The one you pick on the launcher is the one it starts. Click a row to choose it."
                               Style="{StaticResource RowSub}" />

                    <TextBlock x:Name="TxtServerFormTitle" Text="Add a server"
                               Style="{StaticResource RowTitle}" />
                    <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBox x:Name="TxtServerNameEdit" Grid.Column="0" Width="150"
                                 PlaceholderText="Name" />
                        <TextBox x:Name="TxtSiteConfig" Grid.Column="1"
                                 PlaceholderText="myserver.com/SiteConfig.xml" />

                        <Button x:Name="BtnServerSave" Grid.Column="2" Content="Add"
                                Click="ServerAdd_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="BtnServerCancelEdit" Grid.Column="3" Content="Cancel edit"
                                Visibility="Collapsed" Click="ServerCancelEdit_Click" />
                    </Grid>
                    <TextBlock Text="The address is where the game looks up which server to log in to - whoever runs it gives you that. The name is yours to choose."
                               Style="{StaticResource RowSub}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Done" Click="ServersDone_Click" Padding="18,8"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="VerifyOverlay" Visibility="Collapsed" Background="{StaticResource OverlayScrim}">
            <Border MaxWidth="700" Margin="24" VerticalAlignment="Center" Style="{StaticResource OverlayPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Check content" Style="{StaticResource OverlayTitle}" />
                    <Border Style="{StaticResource OverlayRule}" />
                    <TextBlock x:Name="TxtVerifySummary" Style="{StaticResource RowSub}" />

                    <Grid ColumnSpacing="12" ColumnDefinitions="3*,2*" Height="260">
                        <ScrollViewer Grid.Column="0" x:Name="VerifyScroll" Padding="12,8"
                                      CornerRadius="4"
                                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <RichTextBlock x:Name="VerifyText" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>

                        <ScrollViewer Grid.Column="1" x:Name="VerifyFxScroll" Padding="12,8"
                                      CornerRadius="4"
                                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <RichTextBlock x:Name="VerifyFxText" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">

                        <Button x:Name="BtnVerifyCopyMissing" Content="Copy missing content"
                                Click="VerifyCopyMissing_Click" Padding="18,8" IsEnabled="False" />
                        <Button Content="Copy report" Click="VerifyCopy_Click" Padding="18,8" />
                        <Button Content="Check again" Click="Verify_Click" Padding="18,8" />
                        <Button Content="Close check" Click="VerifyClose_Click" Padding="18,8"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
