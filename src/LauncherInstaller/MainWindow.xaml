<Window
    x:Class="LauncherInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LauncherInstaller"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="GAME FOLDER" Style="{StaticResource SectionHeader}" />
                <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                    <TextBox x:Name="TxtGameDir" Grid.Column="0" IsReadOnly="True"
                             PlaceholderText="Pick your Marvel Heroes folder…" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse…"
                            Click="BrowseGameDir_Click" />
                </Grid>
                <TextBlock x:Name="TxtGameDirState" Style="{StaticResource RowSub}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="14" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="INSTALL" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnImport" Content="Install costume…"
                            Style="{StaticResource AccentButtonStyle}" Click="Import_Click" />

                    <Button x:Name="BtnImportFx" Content="Install effects pack…"
                            Click="ImportFx_Click" />

                    <Button x:Name="BtnImportBundle" Content="Install a bundle…"
                            Click="ImportBundle_Click" />
                    <Button x:Name="BtnImportFolder" Content="Install a folder…"
                            Click="ImportFolder_Click" />

                    <Button x:Name="BtnCheck" Content="Check install" Click="Check_Click" />
                    <Button x:Name="BtnRefresh" Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12" ColumnDefinitions="*,*">

            <Border Grid.Column="0" Padding="14" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="8" RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" x:Name="TxtCostumeHeader" Text="COSTUMES"
                               Style="{StaticResource SectionHeader}" />
                    <ListView Grid.Row="1" x:Name="ListCostumes" SelectionMode="Single"
                              BorderThickness="1" CornerRadius="4"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CostumeRow">
                                <StackPanel Margin="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{x:Bind SubText}" Style="{StaticResource RowSub}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" x:Name="BtnRemove" Content="Remove selected costume"
                            HorizontalAlignment="Left" Click="Remove_Click" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14" CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="8" RowDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" x:Name="TxtFxHeader" Text="EFFECTS PACKS"
                               Style="{StaticResource SectionHeader}" />
                    <ListView Grid.Row="1" x:Name="ListFxPacks" SelectionMode="Single"
                              BorderThickness="1" CornerRadius="4"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FxPackRow">
                                <StackPanel Margin="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{x:Bind SubText}" Style="{StaticResource RowSub}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" x:Name="FxWaitingBanner" Visibility="Collapsed"
                            Style="{StaticResource WarnBanner}" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtFxWaiting" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource WarnInk}" />
                    </Border>

                    <Button Grid.Row="3" x:Name="BtnRemoveFx" Content="Remove selected pack"
                            HorizontalAlignment="Left" Click="RemoveFx_Click" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="14" CornerRadius="6" MaxHeight="200"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="8" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="LOG" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="BtnClearLog" Content="Clear" Click="ClearLog_Click" />
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" BorderThickness="0" FontFamily="Consolas"
                             FontSize="12" Background="Transparent" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" x:Name="ImportProgress" Visibility="Collapsed"
                            Margin="0,10,0,0" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" x:Name="TxtProgress" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" x:Name="TxtProgressCount" FontSize="12"
                                   Margin="10,0,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="BarProgress" Minimum="0" Maximum="1" Value="0"
                                 Height="6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
