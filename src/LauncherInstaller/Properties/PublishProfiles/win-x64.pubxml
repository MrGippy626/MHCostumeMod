<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>

    <!-- ⛔ THIS FILE DECIDES IT, NOT THE CSPROJ. <PublishProfile> in CostumeInstaller.csproj
         imports this profile and its values OVERRIDE the project properties, so setting
         SelfContained in the csproj alone silently does nothing. That trap is already recorded
         for the Manager; it applies identically here.

         ⛔⛔ AND THE ANSWER IS THE OPPOSITE OF THE MANAGER'S, ON PURPOSE.
         The Manager is framework-dependent (SelfContained=false) because it is run by the
         SERVER OWNER, who can be asked to install the .NET Desktop Runtime once. This tool is
         run by PLAYERS. The WPF version it replaces was SelfContained + PublishSingleFile for
         exactly that reason, with the comment "Players should not have to install a .NET
         runtime." Making a player install prerequisites before they can install a costume is
         friction the WPF version never had, and it is the difference between a tool that gets
         used and one that gets a support thread. -->
    <SelfContained>true</SelfContained>

    <!-- ⛔ AND .NET SELF-CONTAINED IS ONLY HALF OF IT FOR WinUI. Without this the player also
         needs the Windows App Runtime installed separately - a SECOND prerequisite the WPF
         version did not have, and the one whose absence produces an unhelpful failure with no
         window at all. Both halves or neither; shipping only the .NET half is the worst of the
         three states because it looks self-contained and is not. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- ⚠ NOT single-file, unlike the WPF version. WinUI 3 loads native components
         (Microsoft.ui.xaml.dll and friends) that a single-file bundle has to extract at
         startup anyway, and mixing that with WindowsAppSDKSelfContained is a documented source
         of load failures. A folder is the honest shape here; zip it for distribution.
         ⚑ If this is revisited, measure the published folder before AND after rather than
         assuming - see the pruning note in the csproj. -->
    <PublishSingleFile>False</PublishSingleFile>
  </PropertyGroup>
</Project>
