<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- ⚑ net8.0, not net8.0-windows: decoupling #2 removed the last WPF use
         (a RenderTargetBitmap resize inside GenerateMipMaps). -->
    <TargetFramework>net8.0</TargetFramework>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Compression\License.txt" />
    <Content Include="License.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <!-- BCnEncoder.Net.ImageSharp removed: not referenced anywhere in code,
         and it transitively pulled SixLabors.ImageSharp v3+ which uses the
         Six Labors Split License. Eliminating the bridge package eliminates
         the transitive split-license concern entirely. -->
    <!-- WriteableBitmapEx removed with the WPF resize chain it existed for.
         ImageSharp is pinned to the 2.x line: it is the last APACHE-2.0 release. 3.x moved
         to the Six Labors Split License and 4.x ENFORCES it at build time - see the
         BCnEncoder note above, which is the same concern arriving by a different route. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.11" />
  </ItemGroup>

</Project>
